# Linguist overrides for THIS repository only.
#
# .gitattributes is per-repository -- it has no effect on any other repo. The
# rules below are kept as a template to copy into individual Flutter projects
# (that is where they actually stop a repo being reported as "C++" instead of
# "Dart"); they do nothing here, since this repo holds only Markdown and SVG.
#
# Profile-wide language stats are shaped in .github/workflows/metrics.yml via
# plugin_languages_ignored instead.

# Flutter platform scaffolding -- generated by `flutter create`, not authored
android/**    linguist-vendored=true
ios/**        linguist-vendored=true
linux/**      linguist-vendored=true
macos/**      linguist-vendored=true
windows/**    linguist-vendored=true
web/**        linguist-vendored=true
*.cmake       linguist-generated=true
*.g.dart      linguist-generated=true

# Generated metrics cards -- keep them out of diffs and language stats
metrics.*.svg linguist-generated=true
